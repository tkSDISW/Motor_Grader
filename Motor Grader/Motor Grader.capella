          <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
              id="e00b9021-bce5-466a-b835-347ca1adece5" targetElement="#648848bc-d6f2-4fe7-979f-18f5305e6929"
              sourceElement="#d0bfdd60-f997-4091-a612-d66cdc5bb039"/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="f5a146f0-7ee0-4374-b852-9737fa37dd3e" name="Operator Cabin" description="Houses the operator interface: steering wheel/lever or joystick controls, blade position controls, Cat Grade display/HMI, seat, and cab controls. Realizes operator-facing functions (Steer Machine, Control Blade Position, Monitor Grade Quality, Control Direction of Travel)."/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="378ae3a9-734c-4e1e-a9fa-6f7c125ad10a" name="Engine and Powertrain System"
              description="Cat C7.1/C4.4 engine, powershift transmission, torque converter, and electronic throttle control. Provides power and drive to all other systems (steering, hydraulics, blade actuation)."/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="d67a0ecd-f2e7-478d-9cf3-0e55d26a6e4d" name="Steering System" description="Front axle steering linkage and frame articulation hydraulics, driven by the steering metering pump. Realizes Steer Machine, actuated by commands from the Operator Cabin."/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="8f312bd0-da00-4688-993b-dd5b2136b40f" name="Direction Control System"
              description="Powershift transmission gear selection (forward/reverse) and F-N-R shifter linkage. Realizes Control Direction of Travel, actuated by commands from the Operator Cabin."/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="59dd2973-14d8-4a78-a847-9898d534995d" name="Blade Actuation System"
              description="Drawbar-circle-moldboard mechanism: lift cylinders, circle center shift cylinder, moldboard side-shift cylinder, blade tip cylinder, and circle drive. Realizes Control Blade Position and Accept Blade Position Adjustment."/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="59380b83-cbfd-4006-b7ec-073b9aefa277" name="Grade Control System"
              description="Cat Grade with Cross Slope Assist: blade-mounted slope sensors, Cross Coupling control logic, and electro-hydraulic valves that make automatic elevation/cross-slope corrections. Realizes Monitor Grade Quality and feeds correction commands to the Blade Actuation System."/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="628ea600-0dcc-4903-ae54-648c3b1359ed" name="Attachment Subsystem"
              description="Ripper/scarifier and snow wing attachments and their hydraulic actuation. Realizes Rip and Scarify Hardened Ground and Clear Snow."/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="09aca548-6915-42d6-93e7-8aa4aab00230" name="Telematics Module" description="Product Link onboard telematics hardware, feeding VisionLink off-board. Realizes Deliver Machine Telematics Data, Receive Software, and Provide Diagnostic Data.">
            <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
                id="edaa4a5a-49dd-4d80-8849-9786e859c2b7" targetElement="#653ee354-c0d2-4199-8af8-9b556b5f65c6"
                sourceElement="#09aca548-6915-42d6-93e7-8aa4aab00230"/>
          </ownedLogicalComponents>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="647dd15a-bde4-4b76-a95d-aa3fc4fa471a" name="Service Interface" description="Grouped service access points (filters, fluid check points, diagnostic connector) used during scheduled maintenance. Realizes Accept Service Request.">
            <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
                id="728627fd-5bec-4dae-9371-939f14bd297e" targetElement="#204e1f78-74d7-4d5e-8df4-26846e9d19c2"
                sourceElement="#647dd15a-bde4-4b76-a95d-aa3fc4fa471a"/>
          </ownedLogicalComponents>
        </ownedLogicalComponents>
