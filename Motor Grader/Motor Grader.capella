          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="f5a146f0-7ee0-4374-b852-9737fa37dd3e" name="Operator Cabin" description="Houses the operator interface: steering wheel/lever or joystick controls, blade position controls, Cat Grade display/HMI, seat, and cab controls. Realizes operator-facing functions (Steer Machine, Control Blade Position, Monitor Grade Quality, Control Direction of Travel).">
