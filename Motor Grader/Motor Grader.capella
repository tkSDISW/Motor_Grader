          id="71d0eb03-ab2f-4782-8bbc-01de51c4e667" name="Data"/>
      <ownedLogicalComponentPkg xsi:type="org.polarsys.capella.core.data.la:LogicalComponentPkg"
          id="98b488d1-26f1-4150-aad6-d4d0d0c83a43" name="Structure">
        <ownedParts xsi:type="org.polarsys.capella.core.data.cs:Part" id="68a8dfec-817d-4d96-8f79-0f14ba83d493"
            name="Logical System" abstractType="#d0bfdd60-f997-4091-a612-d66cdc5bb039"/>
        <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
            id="d0bfdd60-f997-4091-a612-d66cdc5bb039" name="Logical System">
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="f5a146f0-7ee0-4374-b852-9737fa37dd3e" description="Houses the operator interface: steering wheel/lever or joystick controls, blade position controls, Cat Grade display/HMI, seat, and cab controls. Realizes operator-facing functions (Steer Machine, Control Blade Position, Monitor Grade Quality, Control Direction of Travel)."
              name="Operator Cabin"/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="378ae3a9-734c-4e1e-a9fa-6f7c125ad10a" description="Cat C7.1/C4.4 engine, powershift transmission, torque converter, and electronic throttle control. Provides power and drive to all other systems (steering, hydraulics, blade actuation)."
              name="Engine and Powertrain System"/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="d67a0ecd-f2e7-478d-9cf3-0e55d26a6e4d" description="Front axle steering linkage and frame articulation hydraulics, driven by the steering metering pump. Realizes Steer Machine, actuated by commands from the Operator Cabin."
              name="Steering System"/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="8f312bd0-da00-4688-993b-dd5b2136b40f" description="Powershift transmission gear selection (forward/reverse) and F-N-R shifter linkage. Realizes Control Direction of Travel, actuated by commands from the Operator Cabin."
              name="Direction Control System"/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="59dd2973-14d8-4a78-a847-9898d534995d" description="Drawbar-circle-moldboard mechanism: lift cylinders, circle center shift cylinder, moldboard side-shift cylinder, blade tip cylinder, and circle drive. Realizes Control Blade Position and Accept Blade Position Adjustment."
              name="Blade Actuation System"/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="59380b83-cbfd-4006-b7ec-073b9aefa277" description="Cat Grade with Cross Slope Assist: blade-mounted slope sensors, Cross Coupling control logic, and electro-hydraulic valves that make automatic elevation/cross-slope corrections. Realizes Monitor Grade Quality and feeds correction commands to the Blade Actuation System."
              name="Grade Control System"/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="628ea600-0dcc-4903-ae54-648c3b1359ed" description="Ripper/scarifier and snow wing attachments and their hydraulic actuation. Realizes Rip and Scarify Hardened Ground and Clear Snow."
              name="Attachment Subsystem"/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="09aca548-6915-42d6-93e7-8aa4aab00230" description="Product Link onboard telematics hardware, feeding VisionLink off-board. Realizes Deliver Machine Telematics Data, Receive Software, and Provide Diagnostic Data."
              name="Telematics Module"/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="647dd15a-bde4-4b76-a95d-aa3fc4fa471a" description="Grouped service access points (filters, fluid check points, diagnostic connector) used during scheduled maintenance. Realizes Accept Service Request."
              name="Service Interface"/>
