            ReqIFText="&lt;p style=&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt&quot;>&lt;span style=&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'&quot;>The system shall achieve a minimum blade width of 12 feet (3.7 m) for standard grading operations.&lt;/span>&lt;/p>">
          <ownedExtensions xsi:type="smw:TcItemRevision" id="2e75701d-c7a9-4ed7-8d69-f7df8355c6df"
              tcuid="AwIAQsrAZ3T1BC" stableTcId="AoAAQsrAZ3T1BC" itemId="REQ-000828"
              revisionId="A"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="da019c23-89b0-4774-b328-cca953915634"
              relationType="#decb38c9-3fdd-4587-b1b8-85600f6a7b8c" relationTypeProxy="Satisfy"
              source="#59dd2973-14d8-4a78-a847-9898d534995d" target="#422bf77f-9dac-4fbf-b060-adaa361ea986">
            <ownedExtensions xsi:type="smw:TcItemRevision" id="8882cdfc-cc1f-48c8-984f-3ac530e5ea4f"
                tcuid="7fDAQsb0Z3T1BC" stableTcId="7fDAQsb0Z3T1BC"/>
          </ownedRelations>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="07b360b8-b088-4190-ac77-37bb089950e8"
            ReqIFLongName="Minimum Engine Power" ReqIFPrefix="REQ-000822/A" requirementType="#432475e8-3d11-47d7-929b-053151910346"
            ReqIFText="&lt;p style=&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt&quot;>&lt;span style=&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'&quot;>The system shall deliver a minimum net engine power of 150 hp (112 kW) to support grading, ripping, and travel operations under full load.&lt;/span>&lt;/p>">
          <ownedExtensions xsi:type="smw:TcItemRevision" id="d6f8f9a9-08bc-48dc-96a6-9d5ba724878c"
              tcuid="AsMAQsrAZ3T1BC" stableTcId="AkEAQsrAZ3T1BC" itemId="REQ-000822"
              revisionId="A"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="6593af9e-f44e-4df0-be56-2552354848cb"
              relationType="#decb38c9-3fdd-4587-b1b8-85600f6a7b8c" relationTypeProxy="Satisfy"
              source="#378ae3a9-734c-4e1e-a9fa-6f7c125ad10a" target="#07b360b8-b088-4190-ac77-37bb089950e8">
            <ownedExtensions xsi:type="smw:TcItemRevision" id="0567c9ce-02e7-4cd4-8bac-338044f24b2f"
                tcuid="7fAAQsb0Z3T1BC" stableTcId="7fAAQsb0Z3T1BC"/>
          </ownedRelations>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="4316e715-e33d-4e39-ae22-a955ff21aa1c"
            ReqIFLongName="Minimum Turning Radius" ReqIFPrefix="REQ-000821/A" requirementType="#432475e8-3d11-47d7-929b-053151910346"
            ReqIFText="&lt;p style=&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt&quot;>&lt;span style=&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'&quot;>The system shall achieve a minimum turning radius of 24 feet (7.3 m) via frame articulation to support maneuvering in confined worksites.&lt;/span>&lt;/p>">
          <ownedExtensions xsi:type="smw:TcItemRevision" id="736c4122-ca51-4fc1-a021-6d1fc32d1274"
              tcuid="AsKAQsrAZ3T1BC" stableTcId="AkCAQsrAZ3T1BC" itemId="REQ-000821"
              revisionId="A"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="e64cfad8-c034-4925-88d1-93be52ddebbd"
              relationType="#decb38c9-3fdd-4587-b1b8-85600f6a7b8c" relationTypeProxy="Satisfy"
              source="#d67a0ecd-f2e7-478d-9cf3-0e55d26a6e4d" target="#4316e715-e33d-4e39-ae22-a955ff21aa1c">
            <ownedExtensions xsi:type="smw:TcItemRevision" id="422d1c38-ce71-4eb6-9ff0-ce92e43d7b2a"
                tcuid="7bBAQsb0Z3T1BC" stableTcId="7bBAQsb0Z3T1BC"/>
          </ownedRelations>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="f126638c-cd21-4a48-8cf7-6a1635973cc9"
            ReqIFLongName="Operator Visibility" ReqIFPrefix="REQ-000824/A" requirementType="#432475e8-3d11-47d7-929b-053151910346"
            ReqIFText="&lt;p style=&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt&quot;>&lt;span style=&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'&quot;>The system shall maintain operator sightlines to the blade, front tires, and rear attachment sufficient to meet applicable visibility standards (e.g., ISO 5006) without obstruction from structural components.&lt;/span>&lt;/p>">
          <ownedExtensions xsi:type="smw:TcItemRevision" id="9899fbe2-5532-4e79-94f5-5dd56d69011d"
              tcuid="AwAAQsrAZ3T1BC" stableTcId="AkIAQsrAZ3T1BC" itemId="REQ-000824"
              revisionId="A"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="7a1ccaa4-cdcf-4200-a447-9191f215a2ae"
              relationType="#decb38c9-3fdd-4587-b1b8-85600f6a7b8c" relationTypeProxy="Satisfy"
              source="#f5a146f0-7ee0-4374-b852-9737fa37dd3e" target="#f126638c-cd21-4a48-8cf7-6a1635973cc9">
            <ownedExtensions xsi:type="smw:TcItemRevision" id="e7b3f709-227e-4e4d-b065-1c7b6851b1e6"
                tcuid="7bKAQsb0Z3T1BC" stableTcId="7bKAQsb0Z3T1BC"/>
          </ownedRelations>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="c928b533-5daf-44e8-9380-94d989b5d246"
            ReqIFLongName="Rear Ripper Attachment" ReqIFPrefix="REQ-000829/A" requirementType="#432475e8-3d11-47d7-929b-053151910346"
            ReqIFText="&lt;p style=&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt&quot;>&lt;span style=&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'&quot;>The system shall support an optional rear ripper/scarifier attachment capable of penetrating compacted material to a minimum depth of 12 inches (30 cm).&lt;/span>&lt;/p>">
          <ownedExtensions xsi:type="smw:TcItemRevision" id="0ee75ce2-6e1f-4069-8fa9-c3c947025f3a"
              tcuid="AwKAQsrAZ3T1BC" stableTcId="AoCAQsrAZ3T1BC" itemId="REQ-000829"
              revisionId="A"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="381a2b0a-4c36-4c2c-aa95-16bf4ed577a4"
              relationType="#decb38c9-3fdd-4587-b1b8-85600f6a7b8c" relationTypeProxy="Satisfy"
              source="#628ea600-0dcc-4903-ae54-648c3b1359ed" target="#c928b533-5daf-44e8-9380-94d989b5d246">
            <ownedExtensions xsi:type="smw:TcItemRevision" id="5c6a0685-5b15-479f-99ac-837a39878b21"
                tcuid="7fJAQsb0Z3T1BC" stableTcId="7fJAQsb0Z3T1BC"/>
          </ownedRelations>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="f69eb750-40a0-4ed7-a0c0-121f3888e4b5"
            ReqIFLongName="ROPS/FOPS Cab Protection" ReqIFPrefix="REQ-000825/A" requirementType="#432475e8-3d11-47d7-929b-053151910346"
            ReqIFText="&lt;p style=&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt&quot;>&lt;span style=&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'&quot;>The system shall provide a ROPS/FOPS-certified cab meeting applicable rollover and falling-object protection standards (e.g., ISO 3471, ISO 3449).&lt;/span>&lt;/p>">
          <ownedExtensions xsi:type="smw:TcItemRevision" id="8a04f2d8-07c2-4b05-b05f-853d3c4af019"
              tcuid="AwCAQsrAZ3T1BC" stableTcId="AkKAQsrAZ3T1BC" itemId="REQ-000825"
              revisionId="A"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="aa57e1d1-d934-4eef-8f71-a08d78b0e517"
              relationType="#decb38c9-3fdd-4587-b1b8-85600f6a7b8c" relationTypeProxy="Satisfy"
              source="#f5a146f0-7ee0-4374-b852-9737fa37dd3e" target="#f69eb750-40a0-4ed7-a0c0-121f3888e4b5">
            <ownedExtensions xsi:type="smw:TcItemRevision" id="7c1a3e20-1f94-4707-b1cc-df482a9d7815"
                tcuid="7bHAQsb0Z3T1BC" stableTcId="7bHAQsb0Z3T1BC"/>
          </ownedRelations>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="4b129944-211f-4a30-a507-80940814224c"
            ReqIFLongName="Six-Way Blade Control" ReqIFPrefix="REQ-000823/A" requirementType="#432475e8-3d11-47d7-929b-053151910346"
            ReqIFText="&lt;p style=&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt&quot;>&lt;span style=&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'&quot;>The system shall provide six-way blade control (raise/lower, tilt, angle, side-shift, circle rotation, articulation) operable from the operator station.&lt;/span>&lt;/p>">
          <ownedExtensions xsi:type="smw:TcItemRevision" id="a94603fa-4124-4c89-9b23-f952c298a49d"
              tcuid="AsOAQsrAZ3T1BC" stableTcId="AkGAQsrAZ3T1BC" itemId="REQ-000823"
              revisionId="A"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="60f5203e-51b5-441b-8ee1-dc8a8476f2cf"
              relationType="#decb38c9-3fdd-4587-b1b8-85600f6a7b8c" relationTypeProxy="Satisfy"
              source="#59380b83-cbfd-4006-b7ec-073b9aefa277" target="#4b129944-211f-4a30-a507-80940814224c">
            <ownedExtensions xsi:type="smw:TcItemRevision" id="9f0c87ce-0609-4ea8-8e84-616d8d9eef90"
                tcuid="7bEAQsb0Z3T1BC" stableTcId="7bEAQsb0Z3T1BC"/>
          </ownedRelations>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="68765427-1419-44d3-be59-357d5ab828e8"
            ReqIFLongName="Telematics Integration" ReqIFPrefix="REQ-000827/A" requirementType="#432475e8-3d11-47d7-929b-053151910346"
            ReqIFText="&lt;p style=&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt&quot;>&lt;span style=&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'&quot;>The system shall support telematics integration for remote monitoring of engine hours, fuel consumption, fault codes, and location data.&lt;/span>&lt;/p>">
          <ownedExtensions xsi:type="smw:TcItemRevision" id="f42624de-385d-47ea-a810-44a9e2dd4775"
              tcuid="AwGAQsrAZ3T1BC" stableTcId="AkOAQsrAZ3T1BC" itemId="REQ-000827"
              revisionId="A"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="d43f5eda-fe95-4da2-bb59-0b6a4f347f39"
              relationType="#decb38c9-3fdd-4587-b1b8-85600f6a7b8c" relationTypeProxy="Satisfy"
              source="#09aca548-6915-42d6-93e7-8aa4aab00230" target="#68765427-1419-44d3-be59-357d5ab828e8">
            <ownedExtensions xsi:type="smw:TcItemRevision" id="1c464adb-0d08-4d1d-b6c2-4be2763f93d8"
                tcuid="7fGAQsb0Z3T1BC" stableTcId="7fGAQsb0Z3T1BC"/>
          </ownedRelations>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Requirement" id="3800d7ea-63c1-4d6d-bc37-5c74a57e30ff"
            ReqIFLongName="Transmission Speed Range" ReqIFPrefix="REQ-000820/A" requirementType="#432475e8-3d11-47d7-929b-053151910346"
            ReqIFText="&lt;p style=&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt&quot;>&lt;span style=&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'&quot;>The system shall provide a hydrostatic or powershift transmission enabling smooth speed transitions between 0 and 25 mph (40 km/h) without blade control interruption.&lt;/span>&lt;/p>">
          <ownedExtensions xsi:type="smw:TcItemRevision" id="60c482d0-2af9-4b48-a168-9a75536caae7"
              tcuid="AsIAQsrAZ3T1BC" stableTcId="AkAAQsrAZ3T1BC" itemId="REQ-000820"
              revisionId="A"/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="fdc75244-47af-4aae-b80c-2af0a1527029"
              relationType="#decb38c9-3fdd-4587-b1b8-85600f6a7b8c" relationTypeProxy="Satisfy"
              source="#378ae3a9-734c-4e1e-a9fa-6f7c125ad10a" target="#3800d7ea-63c1-4d6d-bc37-5c74a57e30ff">
            <ownedExtensions xsi:type="smw:TcItemRevision" id="18dc6b18-d92d-4e2a-bc9c-f6498bc25b98"
                tcuid="7bNAQsb0Z3T1BC" stableTcId="7bNAQsb0Z3T1BC"/>
          </ownedRelations>
        </ownedRequirements>
      </ownedExtensions>
    </ownedExtensions>
