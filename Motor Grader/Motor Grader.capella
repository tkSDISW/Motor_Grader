      ancestor="{&#xA;  &quot;nodes&quot;: [&#xA;    {&#xA;      &quot;files&quot;: [],&#xA;      &quot;projectID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;properties&quot;: {&#xA;        &quot;type&quot;: &quot;Project&quot;,&#xA;        &quot;IsModifiable&quot;: &quot;true&quot;,&#xA;        &quot;Name&quot;: &quot;Motor Grader&quot;,&#xA;        &quot;Format&quot;: &quot;Capella Library&quot;,&#xA;        &quot;ItemID&quot;: &quot;005027&quot;,&#xA;        &quot;ItemRevId&quot;: &quot;A&quot;&#xA;      },&#xA;      &quot;umlID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;fullUmlID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;plmPk&quot;: {&#xA;        &quot;tcuid&quot;: &quot;wnEAQsb0Z3T1BC&quot;,&#xA;        &quot;stableTcId&quot;: &quot;AzEAQsb0Z3T1BC&quot;&#xA;      }&#xA;    },&#xA;    {&#xA;      &quot;files&quot;: [],&#xA;      &quot;projectID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;properties&quot;: {&#xA;        &quot;type&quot;: &quot;PlmRequirement&quot;,&#xA;        &quot;Name&quot;: &quot;Maintenance Accessibility&quot;,&#xA;        &quot;userSpecificInput:ReqContents&quot;: &quot;&lt;p style=\&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt\&quot;>&lt;span style=\&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'\&quot;>The system shall be serviceable such that scheduled maintenance points (fluid checks, filters, grease points) are accessible without requiring attachment or panel removal.&lt;/span>&lt;/p>&quot;,&#xA;        &quot;ItemID&quot;: &quot;REQ-000826&quot;,&#xA;        &quot;ItemRevId&quot;: &quot;A&quot;&#xA;      },&#xA;      &quot;umlID&quot;: &quot;0098397e-0da6-4d38-b62e-eaea6cca910a&quot;,&#xA;      &quot;fullUmlID&quot;: &quot;0098397e-0da6-4d38-b62e-eaea6cca910a&quot;,&#xA;      &quot;plmPk&quot;: {&#xA;        &quot;tcuid&quot;: &quot;AwEAQsrAZ3T1BC&quot;,&#xA;        &quot;stableTcId&quot;: &quot;AkMAQsrAZ3T1BC&quot;&#xA;      }&#xA;    },&#xA;    {&#xA;      &quot;files&quot;: [],&#xA;      &quot;projectID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;properties&quot;: {&#xA;        &quot;type&quot;: &quot;PlmRequirement&quot;,&#xA;        &quot;Name&quot;: &quot;Minimum Blade Width&quot;,&#xA;        &quot;userSpecificInput:ReqContents&quot;: &quot;&lt;p style=\&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt\&quot;>&lt;span style=\&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'\&quot;>The system shall achieve a minimum blade width of 12 feet (3.7 m) for standard grading operations.&lt;/span>&lt;/p>&quot;,&#xA;        &quot;ItemID&quot;: &quot;REQ-000828&quot;,&#xA;        &quot;ItemRevId&quot;: &quot;A&quot;&#xA;      },&#xA;      &quot;umlID&quot;: &quot;422bf77f-9dac-4fbf-b060-adaa361ea986&quot;,&#xA;      &quot;fullUmlID&quot;: &quot;422bf77f-9dac-4fbf-b060-adaa361ea986&quot;,&#xA;      &quot;plmPk&quot;: {&#xA;        &quot;tcuid&quot;: &quot;AwIAQsrAZ3T1BC&quot;,&#xA;        &quot;stableTcId&quot;: &quot;AoAAQsrAZ3T1BC&quot;&#xA;      }&#xA;    },&#xA;    {&#xA;      &quot;files&quot;: [],&#xA;      &quot;projectID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;properties&quot;: {&#xA;        &quot;type&quot;: &quot;PlmRequirement&quot;,&#xA;        &quot;Name&quot;: &quot;Minimum Engine Power&quot;,&#xA;        &quot;userSpecificInput:ReqContents&quot;: &quot;&lt;p style=\&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt\&quot;>&lt;span style=\&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'\&quot;>The system shall deliver a minimum net engine power of 150 hp (112 kW) to support grading, ripping, and travel operations under full load.&lt;/span>&lt;/p>&quot;,&#xA;        &quot;ItemID&quot;: &quot;REQ-000822&quot;,&#xA;        &quot;ItemRevId&quot;: &quot;A&quot;&#xA;      },&#xA;      &quot;umlID&quot;: &quot;07b360b8-b088-4190-ac77-37bb089950e8&quot;,&#xA;      &quot;fullUmlID&quot;: &quot;07b360b8-b088-4190-ac77-37bb089950e8&quot;,&#xA;      &quot;plmPk&quot;: {&#xA;        &quot;tcuid&quot;: &quot;AsMAQsrAZ3T1BC&quot;,&#xA;        &quot;stableTcId&quot;: &quot;AkEAQsrAZ3T1BC&quot;&#xA;      }&#xA;    },&#xA;    {&#xA;      &quot;files&quot;: [],&#xA;      &quot;projectID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;properties&quot;: {&#xA;        &quot;type&quot;: &quot;PlmRequirement&quot;,&#xA;        &quot;Name&quot;: &quot;Minimum Turning Radius&quot;,&#xA;        &quot;userSpecificInput:ReqContents&quot;: &quot;&lt;p style=\&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt\&quot;>&lt;span style=\&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'\&quot;>The system shall achieve a minimum turning radius of 24 feet (7.3 m) via frame articulation to support maneuvering in confined worksites.&lt;/span>&lt;/p>&quot;,&#xA;        &quot;ItemID&quot;: &quot;REQ-000821&quot;,&#xA;        &quot;ItemRevId&quot;: &quot;A&quot;&#xA;      },&#xA;      &quot;umlID&quot;: &quot;4316e715-e33d-4e39-ae22-a955ff21aa1c&quot;,&#xA;      &quot;fullUmlID&quot;: &quot;4316e715-e33d-4e39-ae22-a955ff21aa1c&quot;,&#xA;      &quot;plmPk&quot;: {&#xA;        &quot;tcuid&quot;: &quot;AsKAQsrAZ3T1BC&quot;,&#xA;        &quot;stableTcId&quot;: &quot;AkCAQsrAZ3T1BC&quot;&#xA;      }&#xA;    },&#xA;    {&#xA;      &quot;files&quot;: [],&#xA;      &quot;projectID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;properties&quot;: {&#xA;        &quot;type&quot;: &quot;PlmRequirement&quot;,&#xA;        &quot;Name&quot;: &quot;Operator Visibility&quot;,&#xA;        &quot;userSpecificInput:ReqContents&quot;: &quot;&lt;p style=\&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt\&quot;>&lt;span style=\&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'\&quot;>The system shall maintain operator sightlines to the blade, front tires, and rear attachment sufficient to meet applicable visibility standards (e.g., ISO 5006) without obstruction from structural components.&lt;/span>&lt;/p>&quot;,&#xA;        &quot;ItemID&quot;: &quot;REQ-000824&quot;,&#xA;        &quot;ItemRevId&quot;: &quot;A&quot;&#xA;      },&#xA;      &quot;umlID&quot;: &quot;f126638c-cd21-4a48-8cf7-6a1635973cc9&quot;,&#xA;      &quot;fullUmlID&quot;: &quot;f126638c-cd21-4a48-8cf7-6a1635973cc9&quot;,&#xA;      &quot;plmPk&quot;: {&#xA;        &quot;tcuid&quot;: &quot;AwAAQsrAZ3T1BC&quot;,&#xA;        &quot;stableTcId&quot;: &quot;AkIAQsrAZ3T1BC&quot;&#xA;      }&#xA;    },&#xA;    {&#xA;      &quot;files&quot;: [],&#xA;      &quot;projectID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;properties&quot;: {&#xA;        &quot;type&quot;: &quot;PlmRequirement&quot;,&#xA;        &quot;Name&quot;: &quot;Rear Ripper Attachment&quot;,&#xA;        &quot;userSpecificInput:ReqContents&quot;: &quot;&lt;p style=\&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt\&quot;>&lt;span style=\&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'\&quot;>The system shall support an optional rear ripper/scarifier attachment capable of penetrating compacted material to a minimum depth of 12 inches (30 cm).&lt;/span>&lt;/p>&quot;,&#xA;        &quot;ItemID&quot;: &quot;REQ-000829&quot;,&#xA;        &quot;ItemRevId&quot;: &quot;A&quot;&#xA;      },&#xA;      &quot;umlID&quot;: &quot;c928b533-5daf-44e8-9380-94d989b5d246&quot;,&#xA;      &quot;fullUmlID&quot;: &quot;c928b533-5daf-44e8-9380-94d989b5d246&quot;,&#xA;      &quot;plmPk&quot;: {&#xA;        &quot;tcuid&quot;: &quot;AwKAQsrAZ3T1BC&quot;,&#xA;        &quot;stableTcId&quot;: &quot;AoCAQsrAZ3T1BC&quot;&#xA;      }&#xA;    },&#xA;    {&#xA;      &quot;files&quot;: [],&#xA;      &quot;projectID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;properties&quot;: {&#xA;        &quot;type&quot;: &quot;PlmRequirement&quot;,&#xA;        &quot;Name&quot;: &quot;ROPS/FOPS Cab Protection&quot;,&#xA;        &quot;userSpecificInput:ReqContents&quot;: &quot;&lt;p style=\&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt\&quot;>&lt;span style=\&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'\&quot;>The system shall provide a ROPS/FOPS-certified cab meeting applicable rollover and falling-object protection standards (e.g., ISO 3471, ISO 3449).&lt;/span>&lt;/p>&quot;,&#xA;        &quot;ItemID&quot;: &quot;REQ-000825&quot;,&#xA;        &quot;ItemRevId&quot;: &quot;A&quot;&#xA;      },&#xA;      &quot;umlID&quot;: &quot;f69eb750-40a0-4ed7-a0c0-121f3888e4b5&quot;,&#xA;      &quot;fullUmlID&quot;: &quot;f69eb750-40a0-4ed7-a0c0-121f3888e4b5&quot;,&#xA;      &quot;plmPk&quot;: {&#xA;        &quot;tcuid&quot;: &quot;AwCAQsrAZ3T1BC&quot;,&#xA;        &quot;stableTcId&quot;: &quot;AkKAQsrAZ3T1BC&quot;&#xA;      }&#xA;    },&#xA;    {&#xA;      &quot;files&quot;: [],&#xA;      &quot;projectID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;properties&quot;: {&#xA;        &quot;type&quot;: &quot;PlmRequirement&quot;,&#xA;        &quot;Name&quot;: &quot;Six-Way Blade Control&quot;,&#xA;        &quot;userSpecificInput:ReqContents&quot;: &quot;&lt;p style=\&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt\&quot;>&lt;span style=\&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'\&quot;>The system shall provide six-way blade control (raise/lower, tilt, angle, side-shift, circle rotation, articulation) operable from the operator station.&lt;/span>&lt;/p>&quot;,&#xA;        &quot;ItemID&quot;: &quot;REQ-000823&quot;,&#xA;        &quot;ItemRevId&quot;: &quot;A&quot;&#xA;      },&#xA;      &quot;umlID&quot;: &quot;4b129944-211f-4a30-a507-80940814224c&quot;,&#xA;      &quot;fullUmlID&quot;: &quot;4b129944-211f-4a30-a507-80940814224c&quot;,&#xA;      &quot;plmPk&quot;: {&#xA;        &quot;tcuid&quot;: &quot;AsOAQsrAZ3T1BC&quot;,&#xA;        &quot;stableTcId&quot;: &quot;AkGAQsrAZ3T1BC&quot;&#xA;      }&#xA;    },&#xA;    {&#xA;      &quot;files&quot;: [],&#xA;      &quot;projectID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;properties&quot;: {&#xA;        &quot;type&quot;: &quot;PlmRequirement&quot;,&#xA;        &quot;Name&quot;: &quot;Telematics Integration&quot;,&#xA;        &quot;userSpecificInput:ReqContents&quot;: &quot;&lt;p style=\&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt\&quot;>&lt;span style=\&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'\&quot;>The system shall support telematics integration for remote monitoring of engine hours, fuel consumption, fault codes, and location data.&lt;/span>&lt;/p>&quot;,&#xA;        &quot;ItemID&quot;: &quot;REQ-000827&quot;,&#xA;        &quot;ItemRevId&quot;: &quot;A&quot;&#xA;      },&#xA;      &quot;umlID&quot;: &quot;68765427-1419-44d3-be59-357d5ab828e8&quot;,&#xA;      &quot;fullUmlID&quot;: &quot;68765427-1419-44d3-be59-357d5ab828e8&quot;,&#xA;      &quot;plmPk&quot;: {&#xA;        &quot;tcuid&quot;: &quot;AwGAQsrAZ3T1BC&quot;,&#xA;        &quot;stableTcId&quot;: &quot;AkOAQsrAZ3T1BC&quot;&#xA;      }&#xA;    },&#xA;    {&#xA;      &quot;files&quot;: [],&#xA;      &quot;projectID&quot;: &quot;3ec7c8ef-e215-4950-b74e-e1d063ce486e&quot;,&#xA;      &quot;properties&quot;: {&#xA;        &quot;type&quot;: &quot;PlmRequirement&quot;,&#xA;        &quot;Name&quot;: &quot;Transmission Speed Range&quot;,&#xA;        &quot;userSpecificInput:ReqContents&quot;: &quot;&lt;p style=\&quot;margin-top:0pt; margin-bottom:6pt; font-size:10pt\&quot;>&lt;span style=\&quot;font-family:'Times New Roman'; font-size: 10pt; font-family: 'Times New Roman'\&quot;>The system shall provide a hydrostatic or powershift transmission enabling smooth speed transitions between 0 and 25 mph (40 km/h) without bla